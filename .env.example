# متغيرات البيئة لمشروع أرض النور
# Environment Variables for Ard AlNoor Project

# مفتاح OpenAI API (مطلوب)
# OpenAI API Key (Required)
OPENAI_API_KEY=your-openai-api-key-here

# إعدادات النماذج
# Model Settings
OPENAI_MARKETING_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# إعدادات درجة الحرارة للإبداع
# Temperature setting for creativity
MARKETING_TEMPERATURE=0.7

# إعدادات الخادم
# Server Settings
PORT=5000
FLASK_ENV=development

# إعدادات النشر على المنصات (اختياري)
# Platform Publishing Settings (Optional)
USE_REAL_PLATFORMS=false

# مفاتيح Instagram API (اختياري)
# Instagram API Keys (Optional)
INSTAGRAM_RAPIDAPI_KEY=your-rapidapi-key-here
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# مفاتيح TikTok API (اختياري)
# TikTok API Keys (Optional)
TIKTOK_RAPIDAPI_KEY=your-rapidapi-key-here
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
